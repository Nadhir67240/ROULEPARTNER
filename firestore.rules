rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isVerified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function isAdmin() {
      return isVerified() && request.auth.token.email == 'taxi-vsl67@hotmail.com';
    }
    function isMe(name) {
      return isVerified() && request.auth.token.name == name;
    }
    function isBanned() {
      return exists(/databases/$(database)/documents/profiles/$(request.auth.token.name))
        && get(/databases/$(database)/documents/profiles/$(request.auth.token.name)).data.banned == true;
    }

    function priorityDriversOf(data) {
      return data.get('priorityDrivers', []);
    }
    function priorityUntilOf(data) {
      return data.get('priorityUntil', 0);
    }
    function priorityFieldsUnchanged() {
      return request.resource.data.get('priorityDrivers', []) == resource.data.get('priorityDrivers', [])
        && request.resource.data.get('priorityUntil', 0) == resource.data.get('priorityUntil', 0);
    }
    function isPriorityEligible() {
      // Tant que la Cloud Function notifyNewRide n'a pas encore écrit priorityDrivers sur le
      // document (quelques centaines de ms à quelques secondes après la création), une liste
      // vide est ambiguë : "personne dans le rayon" ou "pas encore calculé" ? On refuse dans ce
      // second cas plutôt que de considérer tout le monde comme prioritaire par défaut, sinon
      // n'importe qui peut voler la priorité pendant cette fenêtre via un appel direct à
      // Firestore.
      return ('priorityDrivers' in resource.data) && (
        priorityDriversOf(resource.data).size() == 0
        || request.time.toMillis() > priorityUntilOf(resource.data)
        || (request.auth.token.name in priorityDriversOf(resource.data))
      );
    }

    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }
    // "Je la prends" : disponible -> en_attente. pendingAt doit être l'heure SERVEUR de la
    // requête (serverTimestamp), impossible à antidater.
    function isClaim() {
      return resource.data.status == 'disponible'
        && resource.data.get('assignedTo', null) == null
        && request.resource.data.status == 'en_attente'
        && request.resource.data.pendingBy == request.auth.token.name
        && request.resource.data.pendingAt == request.time
        && changedOnly(['status', 'pendingBy', 'pendingSince', 'pendingAt'])
        && isPriorityEligible();
    }
    // Le demandeur annule sa demande.
    function isRequesterCancel() {
      return resource.data.status == 'en_attente'
        && resource.data.pendingBy == request.auth.token.name
        && request.resource.data.status == 'disponible'
        && request.resource.data.get('pendingBy', null) == null
        && changedOnly(['status', 'pendingBy', 'pendingSince', 'pendingAt']);
    }
    // Le demandeur se confirme lui-même, mais seulement une fois écoulées les 30 s laissées
    // au posteur pour valider ou refuser (même délai que CLAIM_CONFIRM_WINDOW_MS dans l'appli).
    function isRequesterAutoConfirm() {
      return resource.data.status == 'en_attente'
        && resource.data.pendingBy == request.auth.token.name
        && resource.data.get('pendingAt', null) is timestamp
        && request.time > resource.data.pendingAt + duration.value(30, 's')
        && request.resource.data.status == 'prise'
        && request.resource.data.takenBy == request.auth.token.name
        && request.resource.data.get('pendingBy', null) == null
        && changedOnly(['status', 'takenBy', 'pendingBy', 'pendingSince', 'pendingAt']);
    }
    // Celui qui a la course : la démarrer, la terminer, ou la relâcher avant de la commencer.
    function isTakerAction() {
      return resource.data.takenBy == request.auth.token.name && (
        (resource.data.status == 'prise' && request.resource.data.status == 'en_cours'
          && changedOnly(['status', 'startedAt']))
        || (resource.data.status in ['prise', 'en_cours'] && request.resource.data.status == 'terminee'
          && changedOnly(['status']))
        || (resource.data.status == 'prise' && request.resource.data.status == 'disponible'
          && request.resource.data.get('takenBy', null) == null
          && changedOnly(['status', 'takenBy', 'assignStatus', 'assignRespondedAt'])
          && request.resource.data.get('assignStatus', null) in [resource.data.get('assignStatus', null), 'refusee'])
      );
    }

    // Course envoyée par le posteur à UN chauffeur (assignedTo) : personne d'autre ne peut
    // la demander (isClaim) ; le chauffeur choisi l'accepte directement ou la refuse.
    function isAssignee() {
      return resource.data.get('assignedTo', null) == request.auth.token.name
        && resource.data.status == 'disponible'
        && resource.data.get('assignStatus', null) != 'refusee';
    }
    function isAssigneeAccept() {
      return isAssignee()
        && request.resource.data.status == 'prise'
        && request.resource.data.takenBy == request.auth.token.name
        && changedOnly(['status', 'takenBy']);
    }
    function isAssigneeRefuse() {
      return isAssignee()
        && request.resource.data.assignStatus == 'refusee'
        && changedOnly(['assignStatus', 'assignRespondedAt']);
    }

    // Corbeille : une course n'est jamais effacée par un chauffeur, seulement marquée
    // deleted (récupérable par l'admin). Le posteur ne peut la retirer que tant que
    // personne ne l'a demandée ni prise ; ensuite (prise, en cours, terminée), seul l'admin.
    function isDeleted(data) {
      return data.get('deleted', false) == true;
    }
    function deletionUnchanged() {
      return request.resource.data.get('deleted', false) == resource.data.get('deleted', false)
        && request.resource.data.get('deletedBy', null) == resource.data.get('deletedBy', null)
        && request.resource.data.get('deletedAt', null) == resource.data.get('deletedAt', null);
    }
    function isPosterArchive() {
      return resource.data.postedBy == request.auth.token.name
        && resource.data.status == 'disponible'
        && resource.data.get('pendingBy', null) == null
        && resource.data.get('takenBy', null) == null
        && request.resource.data.deleted == true
        && request.resource.data.deletedBy == request.auth.token.name
        && changedOnly(['deleted', 'deletedBy', 'deletedAt']);
    }
    // Le posteur modifie sa course (trajet, tarif, notes...) sans toucher à qui la fait,
    // ou répond à une demande : confirmer (en_attente -> prise) ou refuser (-> disponible).
    // Il ne peut pas "reprendre" une course déjà prise pour la retirer ensuite.
    function isPosterAction() {
      return resource.data.postedBy == request.auth.token.name && (
        (request.resource.data.status == resource.data.status
          && request.resource.data.get('takenBy', null) == resource.data.get('takenBy', null)
          && request.resource.data.get('pendingBy', null) == resource.data.get('pendingBy', null))
        || (resource.data.status == 'en_attente' && request.resource.data.status == 'prise'
          && request.resource.data.takenBy == resource.data.pendingBy
          && request.resource.data.get('pendingBy', null) == null
          && changedOnly(['status', 'takenBy', 'pendingBy', 'pendingSince', 'pendingAt']))
        || (resource.data.status == 'en_attente' && request.resource.data.status == 'disponible'
          && request.resource.data.get('pendingBy', null) == null
          && changedOnly(['status', 'pendingBy', 'pendingSince', 'pendingAt']))
      );
    }

    // Photo / PDF du bon : jamais dans la fiche de la course (lisible par tous), seulement
    // dans rides/{id}/prive/bon. Les anciennes courses qui les contiennent encore peuvent
    // les garder tels quels ou les retirer, mais pas en ajouter de nouveaux.
    function noInlineAttachment() {
      return request.resource.data.get('photo', null) in [null, resource.data.get('photo', null)]
        && request.resource.data.get('document', null) in [null, resource.data.get('document', null)]
        && request.resource.data.get('documentName', null) in [null, resource.data.get('documentName', null)];
    }

    match /rides/{rideId} {
      allow read: if isVerified();
      allow create: if isAdmin() || (
        isVerified() && !isBanned()
        && request.resource.data.postedBy == request.auth.token.name
        && !('priorityDrivers' in request.resource.data)
        && !('priorityUntil' in request.resource.data)
        && !('photo' in request.resource.data)
        && !('document' in request.resource.data)
        && !('documentName' in request.resource.data)
      );
      // Effacement réel : admin uniquement (les chauffeurs passent par la corbeille).
      allow delete: if isAdmin();
      // Chaque chauffeur n'a droit qu'aux gestes prévus par l'appli, champ par champ.
      // Une course dans la corbeille ne bouge plus (sauf restauration par l'admin).
      allow update: if isAdmin() || (
        isVerified() && !isBanned() && !isDeleted(resource.data)
        && priorityFieldsUnchanged() && noInlineAttachment() && (
          isPosterArchive()
          || (deletionUnchanged() && (
            isPosterAction()
            || isClaim()
            || isRequesterCancel()
            || isRequesterAutoConfirm()
            || isTakerAction()
            || isAssigneeAccept()
            || isAssigneeRefuse()
          ))
        )
      );

      // Photo / PDF du bon : lisibles seulement par le posteur, le chauffeur qui a demandé
      // ou pris la course, et l'admin. Seul le posteur les écrit (getAfter : la course peut
      // être créée dans le même lot d'écritures).
      match /prive/{docId} {
        function rideNow() {
          return get(/databases/$(database)/documents/rides/$(rideId)).data;
        }
        allow read: if isAdmin() || (isVerified() && (
          rideNow().postedBy == request.auth.token.name
          || rideNow().get('takenBy', null) == request.auth.token.name
          || rideNow().get('pendingBy', null) == request.auth.token.name
        ));
        allow create, update: if isAdmin() || (isVerified() && !isBanned()
          && getAfter(/databases/$(database)/documents/rides/$(rideId)).data.postedBy == request.auth.token.name);
        allow delete: if isAdmin() || (isVerified() && !isBanned() && rideNow().postedBy == request.auth.token.name);
      }
    }

    match /positions/{driverId} {
      allow read: if isVerified();
      allow write: if isAdmin() || (isMe(driverId) && !isBanned());
    }

    match /profiles/{driverId} {
      allow read: if isVerified();
      allow write: if isAdmin() || (isMe(driverId) && !isBanned());
      // Inscription : le compte n'a pas encore confirmé son email, mais doit pouvoir
      // créer SA fiche (sinon email/licence/commune ne sont jamais enregistrés).
      // Création seulement (pas d'écrasement d'une fiche existante), jamais bannie d'office.
      allow create: if request.auth != null
        && request.auth.token.name == driverId
        && request.resource.data.keys().hasOnly(['email', 'licenseNumber', 'commune', 'banned', 'createdAt'])
        && request.resource.data.banned == false
        && request.resource.data.email == request.auth.token.email;
    }

    match /messages/{messageId} {
      allow read: if isVerified();
      allow create: if isAdmin() || (isVerified() && !isBanned() && request.resource.data.senderName == request.auth.token.name);
      allow update, delete: if isAdmin() || (isVerified() && !isBanned() && resource.data.senderName == request.auth.token.name);
    }

    match /licenses/{licenseId} {
      allow read: if isVerified();
      allow create: if request.auth != null;
      allow update: if isAdmin();
      allow delete: if isAdmin() || (isVerified() && resource.data.owner == request.auth.token.name);
    }

    match /fcmTokens/{name} {
      allow read: if false;
      allow write: if isAdmin() || (isMe(name) && !isBanned());
    }
  }
}
